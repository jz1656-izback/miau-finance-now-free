[Unit]
Description=CatPod Service — MiauOS Single Binary Runtime
Documentation=https://miau.finance/docs/miauos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miau
Group=miau
ExecStart=/usr/bin/catpod serve --config /etc/catpod/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
CPUShares=512
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/catpod /var/log/catpod

[Install]
WantedBy=multi-user.target
