{
  "name": "Miau Finance",
  "short_name": "Miau",
  "description": "Cat-themed terminal-based financial analytics platform",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a1a14",
  "theme_color": "#0a1a14",
  "orientation": "any",
  "icons": [
    { "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/maskable-icon.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Portfolios",
      "short_name": "Portfolios",
      "description": "View your portfolios",
      "url": "/?cmd=portfolios",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Markets",
      "short_name": "Markets",
      "description": "Market overview",
      "url": "/?cmd=all",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Trades",
      "short_name": "Trades",
      "description": "Recent trades",
      "url": "/?cmd=trades",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/?share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "categories": ["finance", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "screenshots": []
}
