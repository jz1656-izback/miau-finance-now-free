{
  "title": "Miau Finance — Push Notifications",
  "uid": "miau-notifications",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "title": "Notifications Sent / min",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "rate(notifications_sent_total[1m])", "legendFormat": "sent"}],
      "datasource": "Prometheus"
    },
    {
      "title": "Notification Errors",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "rate(notifications_errors_total[1m])", "legendFormat": "errors"}],
      "datasource": "Prometheus"
    },
    {
      "title": "Active Subscriptions",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "notifications_subscriptions_active"}],
      "datasource": "Prometheus"
    },
    {
      "title": "Delivery Latency (p99)",
      "type": "graph",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.99, rate(notification_delivery_seconds_bucket[5m]))", "legendFormat": "p99"}],
      "datasource": "Prometheus"
    },
    {
      "title": "Notification Types",
      "type": "pie",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "sum by (type) (notifications_sent_total)", "legendFormat": "{{type}}"}],
      "datasource": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "type",
        "type": "query",
        "query": "label_values(notifications_sent_total, type)"
      }
    ]
  }
}
