{
  "__inputs": [],
  "__requires": [],
  "title": "Miau Finance — System Monitoring",
  "uid": "miau-monitoring",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 38,
  "tags": ["miau", "monitoring"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "API Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "expr": "rate(miau_requests_total[5m])",
        "legendFormat": "Requests/s"
      }]
    },
    {
      "title": "API Error Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "rate(miau_errors_total[5m])",
        "legendFormat": "Errors/s"
      }]
    },
    {
      "title": "Requests by Path",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "miau_requests_by_path",
        "format": "table",
        "instant": true
      }]
    },
    {
      "title": "Errors by Path",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "miau_errors_by_path",
        "format": "table",
        "instant": true
      }]
    },
    {
      "title": "Request Duration",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "expr": "rate(miau_request_duration_seconds_total[5m])",
        "legendFormat": "Duration/s"
      }]
    },
    {
      "title": "Data Provider Health",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{
        "expr": "miau_providers_healthy",
        "legendFormat": "Healthy"
      }]
    }
  ]
}
