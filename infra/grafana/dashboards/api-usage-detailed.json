{
  "__inputs": [],
  "__requires": [],
  "title": "Miau Finance — API Endpoint Usage",
  "uid": "miau-api-usage",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 38,
  "tags": ["miau", "api"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "expr": "rate(miau_requests_total[5m])",
        "legendFormat": "Requests/s"
      }]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "rate(miau_errors_total[5m])",
        "legendFormat": "Errors/s"
      }]
    },
    {
      "title": "Top Endpoints by Requests",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "topk(10, miau_requests_by_path)",
        "format": "table",
        "instant": true,
        "legendFormat": "__auto"
      }],
      "description": "Top 10 most requested API endpoints",
      "transformations": [
        { "id": "sortBy", "options": { "sort": [{ "field": "Value", "desc": true }] } }
      ]
    },
    {
      "title": "Top Endpoints by Errors",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "topk(10, miau_errors_by_path)",
        "format": "table",
        "instant": true,
        "legendFormat": "__auto"
      }],
      "description": "Top 10 error-prone endpoints",
      "transformations": [
        { "id": "sortBy", "options": { "sort": [{ "field": "Value", "desc": true }] } }
      ]
    },
    {
      "title": "Error Rate by Endpoint",
      "type": "graph",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [{
        "expr": "rate(miau_errors_total[5m]) / rate(miau_requests_total[5m]) * 100",
        "legendFormat": "Error %"
      }],
      "description": "Overall error rate percentage over time"
    },
    {
      "title": "Request Duration",
      "type": "graph",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "targets": [{
        "expr": "rate(miau_request_duration_seconds_total[5m])",
        "legendFormat": "Duration/s"
      }]
    }
  ]
}
